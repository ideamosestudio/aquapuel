Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://aquapuel.com%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^www\.aquapuel\.com$ [NC]
  RewriteRule ^ https://aquapuel.com%{REQUEST_URI} [R=301,L,NE]

  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteRule (^|/)(?:package(?:-lock)?\.json|.*\.(?:map|bak|old|sql|log|ini|env)|composer\.(?:json|lock))$ - [F,L,NC]

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always unset X-Powered-By
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "[-.][a-zA-Z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

<Files "contact.php">
  LimitRequestBody 16384
</Files>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' ; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  <Files "404.html">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-9RQnAw5z79YzzLzjz06wCj8oESn9d76ZphnSKrmOQ/A=' 'sha256-Qi55sqUo7MUPaTwDEuxYKtX6qalhXDdJDErfopAZjpU=' 'sha256-XZUiM/88hyMoEyF4xOYWtTDnJzF/k00Vm9a29WJUOyQ=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-bNUWpWTrtXtWgsOtwSBTw5DBitMj3QPTFKzNovf0q6I=' 'sha256-01MGpnCAVMDYFl6KKUGpdXdMsH4mRJOTo8J80Hr/Zm8=' 'sha256-BF1b6T5+IAITCLshkOrRlqWPzM/OdhGqwoOMUmkSZk4='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  </Files>
  <Files "contacto.html">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-jRGVrigPomLvxqxKjExqjJEQDV0LKlCcex+HnL92F7Q=' 'sha256-Qi55sqUo7MUPaTwDEuxYKtX6qalhXDdJDErfopAZjpU=' 'sha256-ZcbXDyw9X0Oucnn9qply5G/RLC3FVy2vQOiJTii/Hzg=' 'sha256-LW26oJUcG9pZpVUikLKaij696V/Hlz/1xcsJzNvTyi8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  </Files>
  <Files "hogar.html">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Qi55sqUo7MUPaTwDEuxYKtX6qalhXDdJDErfopAZjpU='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  </Files>
  <Files "index.html">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Qi55sqUo7MUPaTwDEuxYKtX6qalhXDdJDErfopAZjpU='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  </Files>
  <Files "oficina.html">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Qi55sqUo7MUPaTwDEuxYKtX6qalhXDdJDErfopAZjpU='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  </Files>
  <Files "quienes-somos.html">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Qi55sqUo7MUPaTwDEuxYKtX6qalhXDdJDErfopAZjpU='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  </Files>
</IfModule>
