Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://aquapuel.com%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^www\.aquapuel\.com$ [NC]
  RewriteRule ^ https://aquapuel.com%{REQUEST_URI} [R=301,L,NE]

  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteRule (^|/)(?:package(?:-lock)?\.json|.*\.map|cpanel-deploy\.log)$ - [F,L,NC]

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "[-.][a-zA-Z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-9RQnAw5z79YzzLzjz06wCj8oESn9d76ZphnSKrmOQ/A=' 'sha256-C3XbcpJIIz3mITM2PkOxCVXI6I0eRbCYgON8eJwMZuc=' 'sha256-66YVrXxRhe95nw8bLaOqIE8hQv7ecOGijR7kTeTU6Ac=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-bNUWpWTrtXtWgsOtwSBTw5DBitMj3QPTFKzNovf0q6I=' 'sha256-L9Kk9iAgvOo4F+tNuX+vA20eb3nmkdVgO3Lun5m0HKE=' 'sha256-HI5dpjz08BR/EMeg+1mZiOnchqY7dFXXv+JJ2HxKkeA=' 'sha256-D/qTkXKA05CaIULbEK+s6+wMTGAgnoRHkmMhTPk1Om4=' 'sha256-d7aokHfK/Exnjkr7HlaA8pcgmc3OnXuOldqzGDwK5bI=' 'sha256-45kMnWUoC/AIm99Q7m6dPKGEU15fKWvJHrpQ6MvfGqc=' 'sha256-BF1b6T5+IAITCLshkOrRlqWPzM/OdhGqwoOMUmkSZk4=' 'sha256-jRGVrigPomLvxqxKjExqjJEQDV0LKlCcex+HnL92F7Q=' 'sha256-7CNsSkqu1ikPJ5w3OGs93HAXVATaysVp09O6Y1SPzps=' 'sha256-gUeurErOecsMOVMm70va9sAbqYpnozzPOxnEWqVLBc4=' 'sha256-skWN1TggkuALsGfm2GjdUFx/sP3kZC5HHzA6wWUBhRw=' 'sha256-aJydyyAbUNeQLLHoeo2BDf9J52+5s5Et/VkCi1EQQT8=' 'sha256-Qf7TAmUdAvRC7so6mokB2qGAFyTBo2BtpUjXhxPFjnQ=' 'sha256-EvFIF5YpnPn/l624KrawSeKEqPBJIazXIH/uD2o/Usc=' 'sha256-3Q3j+9MQkjyOUV0u7td2K5oZW+f9N3x1j+1EBmhcSuI=' 'sha256-IzAevGEFa/vAEOZVt1B8zenjkWVdow0+UVmyeWD/xnU=' 'sha256-wTFsjfITVs9aCOM4t7+YHj4/S4PAjuGNl14JAydUkjs=' 'sha256-/WxWXiLfbRLzEOsQYIAmyh0qxdfEfU9D77+c2WAmL6U=' 'sha256-W1q7JKAxhDZWWek5i2+ps9M92qbHbfDb24VZylaZE48=' 'sha256-n4KDD2bH6GZc6MzWreKYimLa+fR4IwgD9ToaF460mjs=' 'sha256-nhV6mDh8wL2L2iXeZoMFtKx5DU2/gpe4S7nX7vbGXlg=' 'sha256-uB5W/cqBbiE11uy1lNeQn+eFnT9PLoKsEo7h6X1LDwk=' 'sha256-8apnBfi05ivGcYESUk0lNddmwQyQPudQGq6v4NrvJ2E=' 'sha256-PgXmOuq23DeVIcq0TDjGSDksdwUT433x5d+shCb/6CQ=' 'sha256-fpyZwyIExUK55wYGi+Ax83O7o0qH0ewieIw+oAnJX24=' 'sha256-Q4nl0pBkTZVTxoAOGhILHqlp2H8gJwp6EFEbV+iMHjo=' 'sha256-zZaX63UlfZzNNZ/3K0mxgGVprnz+BD48g7YuDzTOcBc=' 'sha256-cwpabbqxjInHiY0kw0Mk1NXUnoLLH9W6iFigt6zy9/I=' 'sha256-a7bMKixcGPMpkCpGx0ZiPMTWFYCnwkcQjqkb60APS34=' 'sha256-ky5Uol5T+04HyDFf5UTSTpGeG8T1dnWScxkZbY+lm/Y=' 'sha256-NDvKhPMmRYmd4ExDscTwE30XpagiXFCY1mqlYQjqGMM=' 'sha256-b7TgQgwCF0cvTbbMFPp